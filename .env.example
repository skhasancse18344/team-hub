# API
PORT=4000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/teamhub
NODE_ENV=development
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# Cloudinary (avatar uploads — server-side only, never expose to browser)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Web (prefix NEXT_PUBLIC_ for browser exposure)
NEXT_PUBLIC_API_URL=http://localhost:3026
NEXT_PUBLIC_WS_URL=http://localhost:3026
